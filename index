/* ═══════════════════════════════════════════════
   PANIC TIMER
═══════════════════════════════════════════════ */
function PanicTimer() {
  const [secs, setSecs]       = useState(null);
  const [running, setRunning] = useState(false);
  const ref = useRef(null);

  useEffect(() => {
    if (running && secs > 0) ref.current = setTimeout(() => setSecs((s) => s - 1), 1000);
    else if (running && secs === 0) setRunning(false);
    return () => clearTimeout(ref.current);
  }, [running, secs]);

  const start = () => { setSecs(900); setRunning(true); };
  const stop  = () => { setRunning(false); setSecs(null); };
  const pct   = secs != null ? ((900 - secs) / 900) * 100 : 0;
  const mm    = secs != null ? String(Math.floor(secs / 60)).padStart(2, "0") : "15";
  const ss    = secs != null ? String(secs % 60).padStart(2, "0") : "00";
  const done  = secs === 0;

  return (
    <div style={{ background: "#13161c", border: `1px solid ${done ? "#00d4aa55" : running ? "#e8445a55" : "#1e2229"}`, borderRadius: 12, padding: "16px 20px", marginBottom: 20 }}>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
        <p style={{ color: "#4a5060", fontSize: 10, letterSpacing: "0.1em", margin: 0 }}>🚨 15-MIN PANIC TIMER</p>
        <span style={{ fontFamily: "'Syne',sans-serif", fontWeight: 700, fontSize: 22, color: done ? "#00d4aa" : running ? "#e8445a" : "#2a2f3a" }}>{mm}:{ss}</span>
      </div>
      <div style={{ height: 4, background: "#1e2229", borderRadius: 2, overflow: "hidden", marginBottom: 12 }}>
        <div style={{ height: "100%", width: `${pct}%`, background: done ? "#00d4aa" : "#e8445a", borderRadius: 2, transition: "width 1s linear" }} />
      </div>
      {done
        ? <p style={{ color: "#00d4aa", fontSize: 12, margin: "0 0 10px" }}>✓ 15 minutes passed. Now decide with a clear head.</p>
        : <p style={{ color: "#4a5060", fontSize: 11, margin: "0 0 10px", lineHeight: 1.5 }}>
            {running ? "Breathe. Don't touch the trade until this finishes." : "Feeling the urge to close early? Start the timer before touching anything."}
          </p>
      }
      <div style={{ display: "flex", gap: 8 }}>
        {!running && !done && (
          <button onClick={start} style={{ background: "#e8445a22", border: "1px solid #e8445a55", color: "#e8445a", fontFamily: "'DM Mono',monospace", fontSize: 11, padding: "7px 16px", borderRadius: 6, cursor: "pointer" }}>START TIMER</button>
        )}
        {(running || done) && (
          <button onClick={stop} style={{ background: "transparent", border: "1px solid #2a2f3a", color: "#4a5060", fontFamily: "'DM Mono',monospace", fontSize: 11, padding: "7px 16px", borderRadius: 6, cursor: "pointer" }}>RESET</button>
        )}
      </div>
    </div>
  );
}

/* ═══════════════════════════════════════════════
   CHECKLIST TAB
═══════════════════════════════════════════════ */
function Checklist({ uid }) {
  const [checked,   setCheckedState] = useState({});
  const [collapsed, setCollapsed]    = useState({});
  const [mood,      setMoodState]    = useState(0);
  const [saving,    setSaving]       = useState(false);
  const saveTimer = useRef(null);

  // Load from Firestore on mount
  useEffect(() => {
    if (!uid) return;
    getDoc(userDoc(uid, "data", "checklist")).then((snap) => {
      if (snap.exists()) {
        const d = snap.data();
        if (d.checked) setCheckedState(d.checked);
        if (d.mood)    setMoodState(d.mood);
      }
    });
  }, [uid]);

  // Debounced save to Firestore
  const saveToFirestore = (checked, mood) => {
    clearTimeout(saveTimer.current);
    setSaving(true);
    saveTimer.current = setTimeout(async () => {
      await setDoc(userDoc(uid, "data", "checklist"), { checked, mood }, { merge: true });
      setSaving(false);
    }, 800);
  };

  const setChecked = (fn) => {
    setCheckedState((prev) => {
      const next = typeof fn === "function" ? fn(prev) : fn;
      saveToFirestore(next, mood);
      return next;
    });
  };
  const setMood = (val) => {
    setMoodState(val);
    saveToFirestore(checked, val);
  };

  const toggle        = (sid, idx) => setChecked((p) => ({ ...p, [`${sid}-${idx}`]: !p[`${sid}-${idx}`] }));
  const toggleSection = (id)       => setCollapsed((p) => ({ ...p, [id]: !p[id] }));
  const checkedCount  = Object.values(checked).filter(Boolean).length;
  const progress      = Math.round((checkedCount / TOTAL_ITEMS) * 100);
  const secProg       = (s)        => s.items.filter((_, i) => checked[`${s.id}-${i}`]).length;

  return (
    <div>
      <MoodCheck mood={mood} setMood={setMood} />

      <div style={{ marginBottom: 20 }}>
        <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 8 }}>
          <span style={{ color: "#4a5060", fontSize: 12, letterSpacing: "0.08em" }}>CHECKLIST PROGRESS</span>
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            {saving && <span style={{ color: "#3a3f4a", fontSize: 9, letterSpacing: "0.06em" }}>saving…</span>}
            <span style={{ fontSize: 13, color: progress === 100 ? "#00d4aa" : "#f0f0f0" }}>{checkedCount}/{TOTAL_ITEMS}</span>
          </div>
        </div>
        <div style={{ height: 6, background: "#1e2229", borderRadius: 3, overflow: "hidden" }}>
          <div style={{ height: "100%", width: `${progress}%`, background: progress === 100 ? "#00d4aa" : "linear-gradient(90deg,#00d4aa,#a78bfa)", borderRadius: 3, transition: "width 0.4s ease" }} />
        </div>
        {progress === 100 && <p style={{ color: "#00d4aa", fontSize: 12, marginTop: 8 }}>✓ ALL CLEAR — YOU'RE READY TO TRADE</p>}
      </div>

      {SECTIONS.map((section) => {
        const done = secProg(section);
        const isCollapsed = collapsed[section.id];
        return (
          <div key={section.id} className="section-card">
            <div className="section-header" onClick={() => toggleSection(section.id)}>
              <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                <span style={{ fontSize: 18 }}>{section.emoji}</span>
                <span style={{ fontFamily: "'Syne',sans-serif", fontWeight: 700, fontSize: 13, color: "#d0d4dc", letterSpacing: "0.06em" }}>{section.label.toUpperCase()}</span>
              </div>
              <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
                <span style={{ fontSize: 11, color: done === section.items.length ? section.color : "#4a5060" }}>{done}/{section.items.length}</span>
                <span className="chevron" style={{ transform: isCollapsed ? "rotate(-90deg)" : "rotate(0deg)" }}>▾</span>
              </div>
            </div>
            <div className="progress-bar">
              <div style={{ height: "100%", width: `${Math.round((done / section.items.length) * 100)}%`, background: section.color, borderRadius: 2, transition: "width 0.3s" }} />
            </div>
            {!isCollapsed && (
              <div style={{ padding: "0 8px 12px" }}>
                {section.id === "early-exit" && <div style={{ padding: "0 4px 8px" }}><PanicTimer /></div>}
                {section.items.map((item, idx) => {
                  const isChecked = !!checked[`${section.id}-${idx}`];
                  return (
                    <div key={idx} className={`check-item ${isChecked ? "done" : ""}`} onClick={() => toggle(section.id, idx)}>
                      <div className="checkbox" style={{ borderColor: isChecked ? section.color : "#2a2f3a", background: isChecked ? section.color : "transparent", color: "#0a0c10" }}>
                        {isChecked && "✓"}
                      </div>
                      <span style={{ color: isChecked ? "#3a3f4a" : "#8a909c", fontSize: 13, lineHeight: 1.5, textDecoration: isChecked ? "line-through" : "none" }}>{item}</span>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        );
      })}

      <div style={{ background: "#0f1115", border: "1px solid #1e2229", borderLeft: "3px solid #00d4aa", borderRadius: 8, padding: "16px 20px", marginTop: 8, marginBottom: 20 }}>
        <p style={{ color: "#4a5060", fontSize: 11, letterSpacing: "0.1em", margin: "0 0 8px" }}>CORE RULE</p>
        <p style={{ color: "#8a909c", fontSize: 13, lineHeight: 1.6, margin: 0 }}>
          Fear alone is <span style={{ color: "#e8445a", fontWeight: 500 }}>NOT</span> a valid reason to close.
          Your plan was made with a clear head. <span style={{ color: "#00d4aa" }}>Trust that version of you.</span>
        </p>
      </div>

      <button onClick={() => setChecked({})}
        onMouseEnter={(e) => { e.currentTarget.style.borderColor = "#e8445a"; e.currentTarget.style.color = "#e8445a"; }}
        onMouseLeave={(e) => { e.currentTarget.style.borderColor = "#2a2f3a"; e.currentTarget.style.color = "#555"; }}
        style={{ background: "transparent", border: "1px solid #2a2f3a", color: "#555", padding: "8px 20px", borderRadius: 6, cursor: "pointer", fontFamily: "'DM Mono',monospace", fontSize: 12, letterSpacing: "0.05em", transition: "all 0.2s" }}>
        ↺ RESET CHECKLIST
      </button>
    </div>
  );
}

/* ═══════════════════════════════════════════════
   RISK CALCULATOR TAB
═══════════════════════════════════════════════ */
function RiskCalculator({ uid, onLogTrade }) {
  const [currency,  setCurrencyState]  = useState("USD");
  const [direction, setDirection]      = useState("long");
  const [fields,    setFieldsState]    = useState({
    capital: "", riskPct: "", entryPrice: "", stopPrice: "",
    targetPrice: "", shares: "", commission: "", openTrades: "", thesis: "",
  });
  const [saving, setSaving] = useState(false);
  const saveTimer = useRef(null);

  useEffect(() => {
    if (!uid) return;
    getDoc(userDoc(uid, "data", "calculator")).then((snap) => {
      if (snap.exists()) {
        const d = snap.data();
        if (d.currency)  setCurrencyState(d.currency);
        if (d.direction) setDirection(d.direction);
        if (d.fields)    setFieldsState(d.fields);
      }
    });
  }, [uid]);

  const persist = (currency, direction, fields) => {
    clearTimeout(saveTimer.current);
    setSaving(true);
    saveTimer.current = setTimeout(async () => {
      await setDoc(userDoc(uid, "data", "calculator"), { currency, direction, fields }, { merge: true });
      setSaving(false);
    }, 800);
  };

  const setCurrency  = (v) => { setCurrencyState(v);  persist(v, direction, fields); };
  const setDirection2 = (v) => { setDirection(v);     persist(currency, v, fields); };
  const upd = (k) => (e) => {
    const next = { ...fields, [k]: e.target.value };
    setFieldsState(next);
    persist(currency, direction, next);
  };

  const sym = CURRENCIES[currency];

  const r = useMemo(() => {
    const capital    = toNum(fields.capital);
    const riskPct    = toNum(fields.riskPct);
    const entry      = toNum(fields.entryPrice);
    const stop       = toNum(fields.stopPrice);
    const target     = toNum(fields.targetPrice);
    const sharesM    = toNum(fields.shares);
    const commission = toNum(fields.commission);
    const openTrades = toNum(fields.openTrades);
    const isLong     = direction === "long";
    const validStop   = entry > 0 && stop > 0  && (isLong ? stop < entry  : stop > entry);
    const validTarget = entry > 0 && target > 0 && (isLong ? target > entry : target < entry);
    const maxRisk        = capital > 0 && riskPct > 0 ? (capital * riskPct) / 100 : null;
    const riskPerShare   = validStop   ? Math.abs(entry - stop)   : null;
    const rewardPerShare = validTarget ? Math.abs(target - entry)  : null;
    const rrRatio        = riskPerShare && rewardPerShare ? rewardPerShare / riskPerShare : null;
    const suggested      = maxRisk && riskPerShare ? Math.floor(maxRisk / riskPerShare) : null;
    const shares         = sharesM > 0 ? sharesM : suggested;
    const positionSize   = shares && entry > 0 ? shares * entry : null;
    const totalComm      = shares && commission > 0 ? shares * commission * 2 : 0;
    const maxLoss        = shares && riskPerShare  ? shares * riskPerShare  + totalComm : null;
    const maxGain        = shares && rewardPerShare ? shares * rewardPerShare - totalComm : null;
    const pctOfCapital   = positionSize && capital > 0 ? (positionSize / capital) * 100 : null;
    const breakEven      = shares && entry > 0 && commission > 0
      ? isLong ? entry + totalComm / shares : entry - totalComm / shares : null;
    const portfolioHeat  = openTrades > 0 && riskPct > 0 ? (openTrades + 1) * riskPct : null;
    return { maxRisk, riskPerShare, rewardPerShare, rrRatio, suggested, shares, positionSize, totalComm, maxLoss, maxGain, pctOfCapital, breakEven, portfolioHeat, validStop, validTarget };
  }, [fields, direction]);

  const rrColor = r.rrRatio == null ? "#4a5060" : r.rrRatio >= 2 ? "#00d4aa" : r.rrRatio >= 1 ? "#f5a623" : "#e8445a";
  const rrLabel = r.rrRatio == null ? "" : r.rrRatio >= 2 ? "GOOD" : r.rrRatio >= 1 ? "MARGINAL" : "POOR";

  const RRow = ({ label, value, color = "#8a909c", sub = "" }) => (
    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "9px 0", borderBottom: "1px solid #141720" }}>
      <span style={{ color: "#4a5060", fontSize: 11, letterSpacing: "0.06em" }}>{label}{sub && <span style={{ color: "#2a2f3a", fontSize: 9, marginLeft: 6 }}>{sub}</span>}</span>
      <span style={{ color, fontSize: 13, fontFamily: "'DM Mono',monospace" }}>{value}</span>
    </div>
  );

  const handleLogTrade = () => {
    if (!fields.entryPrice || !fields.stopPrice || !fields.targetPrice) return;
    onLogTrade({
      date: new Date().toISOString(), direction, currency,
      entry: fields.entryPrice, stop: fields.stopPrice, target: fields.targetPrice,
      shares: r.shares || fields.shares, maxLoss: r.maxLoss, maxGain: r.maxGain,
      rrRatio: r.rrRatio, thesis: fields.thesis,
      result: "", exitPrice: "", discipline: "", notes: "",
    });
  };

  return (
    <div>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20 }}>
        <div style={{ display: "flex", background: "#0d1014", borderRadius: 6, border: "1px solid #1e2229", overflow: "hidden" }}>
          {["long", "short"].map((d) => (
            <button key={d} onClick={() => setDirection2(d)} style={{
              background: direction === d ? (d === "long" ? "#00d4aa22" : "#e8445a22") : "transparent",
              border: "none", color: direction === d ? (d === "long" ? "#00d4aa" : "#e8445a") : "#4a5060",
              fontFamily: "'DM Mono',monospace", fontSize: 11, padding: "6px 16px", cursor: "pointer", letterSpacing: "0.08em", transition: "all 0.2s",
            }}>{d === "long" ? "▲ LONG" : "▼ SHORT"}</button>
          ))}
        </div>
        <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
          {saving && <span style={{ color: "#3a3f4a", fontSize: 9 }}>saving…</span>}
          <div style={{ display: "flex", background: "#0d1014", borderRadius: 6, border: "1px solid #1e2229", overflow: "hidden" }}>
            {Object.keys(CURRENCIES).map((c) => (
              <button key={c} onClick={() => setCurrency(c)} style={{
                background: currency === c ? "#1e2229" : "transparent", border: "none",
                color: currency === c ? "#00d4aa" : "#4a5060", fontFamily: "'DM Mono',monospace",
                fontSize: 11, padding: "6px 16px", cursor: "pointer", letterSpacing: "0.08em", transition: "all 0.2s",
              }}>{c}</button>
            ))}
          </div>
        </div>
      </div>

      <div style={{ marginBottom: 16 }}>
        <label style={SL}>TRADE THESIS (ONE SENTENCE)</label>
        <textarea value={fields.thesis} onChange={upd("thesis")} placeholder="Why am I entering this trade?" rows={2}
          style={{ ...SI, resize: "none", lineHeight: 1.5 }} onFocus={hl("#a78bfa")} onBlur={uhl} />
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 20 }}>
        {[
          [`TOTAL CAPITAL (${currency})`, "capital",     "#00d4aa"],
          ["RISK PER TRADE (%)",          "riskPct",     "#00d4aa"],
          [`ENTRY PRICE (${currency})`,   "entryPrice",  "#f5a623"],
          [`STOP-LOSS (${currency})`,     "stopPrice",   "#e8445a"],
          [`TAKE-PROFIT (${currency})`,   "targetPrice", "#a78bfa"],
          ["COMMISSION PER SHARE",        "commission",  "#8a909c"],
          ["OPEN TRADES (excl. this)",    "openTrades",  "#8a909c"],
        ].map(([label, key, accent]) => (
          <div key={key}>
            <label style={SL}>{label}</label>
            <input style={SI} inputMode="decimal" value={fields[key]} onChange={upd(key)} onFocus={hl(accent)} onBlur={uhl} placeholder="0" />
          </div>
        ))}
        <div>
          <label style={SL}>SHARES <span style={{ color: "#2a2f3a" }}>(BLANK = AUTO)</span></label>
          <input style={SI} inputMode="decimal" value={fields.shares} onChange={upd("shares")} onFocus={hl("#f5a623")} onBlur={uhl}
            placeholder={r.suggested != null ? `${r.suggested} (auto)` : "0"} />
        </div>
      </div>

      {fields.stopPrice   && fields.entryPrice && !r.validStop   && <div style={{ background: "#e8445a18", border: "1px solid #e8445a44", borderRadius: 8, padding: "8px 14px", marginBottom: 12 }}><p style={{ color: "#e8445a", fontSize: 11, margin: 0 }}>⚠ Stop-loss is on the wrong side for a {direction} trade.</p></div>}
      {fields.targetPrice && fields.entryPrice && !r.validTarget && <div style={{ background: "#e8445a18", border: "1px solid #e8445a44", borderRadius: 8, padding: "8px 14px", marginBottom: 12 }}><p style={{ color: "#e8445a", fontSize: 11, margin: 0 }}>⚠ Take-profit is on the wrong side for a {direction} trade.</p></div>}

      <div style={{ background: "#0d1014", borderRadius: 10, padding: "4px 16px 8px", border: "1px solid #1a1d24", marginBottom: 16 }}>
        <RRow label="MAX RISK AMOUNT"  value={fmt(r.maxRisk, sym)}       color={r.maxRisk ? "#e8445a" : "#4a5060"} />
        <RRow label="RISK PER SHARE"   value={fmt(r.riskPerShare, sym)} />
        <RRow label="REWARD PER SHARE" value={fmt(r.rewardPerShare, sym)} />
        <RRow label="SUGGESTED SHARES" value={r.suggested != null ? `${r.suggested}` : "—"} />
        <RRow label="POSITION SIZE"    value={fmt(r.positionSize, sym)} />
        <RRow label="% OF CAPITAL"     value={r.pctOfCapital != null ? `${r.pctOfCapital.toFixed(1)}%` : "—"} color={r.pctOfCapital > 20 ? "#e8445a" : "#8a909c"} />
        <RRow label="COMMISSION (RT)"  value={r.totalComm > 0 ? fmt(r.totalComm, sym) : "—"} sub="round-trip" />
        <RRow label="BREAK-EVEN"       value={fmt(r.breakEven, sym)} color="#f5a623" />
        <RRow label="MAX LOSS (net)"   value={r.maxLoss != null ? `-${fmt(r.maxLoss, sym)}` : "—"} color={r.maxLoss ? "#e8445a" : "#4a5060"} />
        <RRow label="MAX GAIN (net)"   value={fmt(r.maxGain, sym)} color={r.maxGain ? "#00d4aa" : "#4a5060"} />
        <RRow label="PORTFOLIO HEAT"   value={r.portfolioHeat != null ? `${r.portfolioHeat.toFixed(1)}%` : "—"} color={r.portfolioHeat > 5 ? "#e8445a" : r.portfolioHeat > 3 ? "#f5a623" : "#8a909c"} sub="all open trades" />
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "10px 0 4px" }}>
          <span style={{ color: "#4a5060", fontSize: 11, letterSpacing: "0.06em" }}>R:R RATIO</span>
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            {rrLabel && <span style={{ color: rrColor, fontSize: 9, letterSpacing: "0.12em", background: `${rrColor}22`, padding: "3px 8px", borderRadius: 4 }}>{rrLabel}</span>}
            <span style={{ color: rrColor, fontSize: 20, fontWeight: 700, fontFamily: "'Syne',sans-serif" }}>{r.rrRatio != null ? `${r.rrRatio.toFixed(2)}R` : "—"}</span>
          </div>
        </div>
      </div>

      {r.rrRatio != null && r.rrRatio < 1.5 && <div style={{ background: "#e8445a18", border: "1px solid #e8445a44", borderRadius: 8, padding: "10px 14px", marginBottom: 12 }}><p style={{ color: "#e8445a", fontSize: 12, margin: 0 }}>⚠ R:R below 1.5 — consider adjusting your target or skip this trade.</p></div>}
      {r.rrRatio != null && r.rrRatio >= 2 && <div style={{ background: "#00d4aa18", border: "1px solid #00d4aa44", borderRadius: 8, padding: "10px 14px", marginBottom: 12 }}><p style={{ color: "#00d4aa", fontSize: 12, margin: 0 }}>✓ Solid setup — R:R meets swing trading standards.</p></div>}
      {r.portfolioHeat != null && r.portfolioHeat > 5 && <div style={{ background: "#e8445a18", border: "1px solid #e8445a44", borderRadius: 8, padding: "10px 14px", marginBottom: 12 }}><p style={{ color: "#e8445a", fontSize: 12, margin: 0 }}>⚠ Portfolio heat {r.portfolioHeat.toFixed(1)}% — you're overexposed.</p></div>}

      <div style={{ display: "flex", gap: 10, flexWrap: "wrap" }}>
        <button onClick={handleLogTrade} style={{ background: "#00d4aa22", border: "1px solid #00d4aa55", color: "#00d4aa", fontFamily: "'DM Mono',monospace", fontSize: 11, padding: "8px 18px", borderRadius: 6, cursor: "pointer", letterSpacing: "0.06em" }}>
          + LOG THIS TRADE
        </button>
        <button onClick={() => { const next = { ...fields, entryPrice: "", stopPrice: "", targetPrice: "", shares: "", thesis: "" }; setFieldsState(next); persist(currency, direction, next); }}
          onMouseEnter={(e) => { e.currentTarget.style.borderColor = "#e8445a"; e.currentTarget.style.color = "#e8445a"; }}
          onMouseLeave={(e) => { e.currentTarget.style.borderColor = "#2a2f3a"; e.currentTarget.style.color = "#4a5060"; }}
          style={{ background: "transparent", border: "1px solid #2a2f3a", color: "#4a5060", fontFamily: "'DM Mono',monospace", fontSize: 11, padding: "8px 18px", borderRadius: 6, cursor: "pointer", letterSpacing: "0.06em", transition: "all 0.2s" }}>
          ↺ CLEAR TRADE
        </button>
      </div>
    </div>
  );
}

/* ═══════════════════════════════════════════════
   TRADE LOG TAB
═══════════════════════════════════════════════ */
function TradeLog({ uid, trades, setTrades }) {
  const [editing, setEditing] = useState(null);
  const [saving,  setSaving]  = useState(false);

  const saveTrades = async (updated) => {
    setSaving(true);
    await setDoc(userDoc(uid, "data", "trades"), { list: updated });
    setSaving(false);
  };

  const updateTrade = (i, key, val) => {
    const updated = trades.map((t, idx) => idx === i ? { ...t, [key]: val } : t);
    setTrades(updated);
    saveTrades(updated);
  };

  const deleteTrade = (i) => {
    const updated = trades.filter((_, idx) => idx !== i);
    setTrades(updated);
    saveTrades(updated);
  };

  const wins    = trades.filter((t) => t.result === "win").length;
  const losses  = trades.filter((t) => t.result === "loss").length;
  const avgDisc = trades.filter((t) => t.discipline).length
    ? (trades.reduce((a, t) => a + (parseFloat(t.discipline) || 0), 0) / trades.filter((t) => t.discipline).length).toFixed(1)
    : null;
  const sym = (t) => CURRENCIES[t.currency] || "$";

  return (
    <div>
      {trades.length > 0 && (
        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr 1fr", gap: 8, marginBottom: 20 }}>
          {[
            { label: "TRADES",   value: trades.length, color: "#d0d4dc" },
            { label: "WINS",     value: wins,           color: "#00d4aa" },
            { label: "LOSSES",   value: losses,         color: "#e8445a" },
            { label: "AVG DISC", value: avgDisc ? `${avgDisc}/10` : "—", color: "#a78bfa" },
          ].map((s) => (
            <div key={s.label} style={{ background: "#13161c", border: "1px solid #1e2229", borderRadius: 8, padding: "12px 10px", textAlign: "center" }}>
              <div style={{ color: s.color, fontFamily: "'Syne',sans-serif", fontWeight: 700, fontSize: 18 }}>{s.value}</div>
              <div style={{ color: "#4a5060", fontSize: 9, letterSpacing: "0.1em", marginTop: 2 }}>{s.label}</div>
            </div>
          ))}
        </div>
      )}

      {saving && <p style={{ color: "#3a3f4a", fontSize: 10, margin: "0 0 12px" }}>Saving…</p>}

      {trades.length === 0 ? (
        <div style={{ background: "#13161c", border: "1px solid #1e2229", borderRadius: 12, padding: "40px 20px", textAlign: "center" }}>
          <p style={{ color: "#2a2f3a", fontSize: 13, margin: 0 }}>No trades logged yet.</p>
          <p style={{ color: "#2a2f3a", fontSize: 11, margin: "8px 0 0" }}>Use the Risk Calc tab to plan a trade and hit "+ LOG THIS TRADE".</p>
        </div>
      ) : (
        [...trades].reverse().map((trade, ri) => {
          const i = trades.length - 1 - ri;
          const isOpen = trade.result === "";
          return (
            <div key={i} style={{ background: "#13161c", border: `1px solid ${trade.result === "win" ? "#00d4aa33" : trade.result === "loss" ? "#e8445a33" : "#1e2229"}`, borderRadius: 12, padding: "16px", marginBottom: 12 }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 10 }}>
                <div>
                  <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 4 }}>
                    <span style={{ color: trade.direction === "long" ? "#00d4aa" : "#e8445a", fontSize: 10, letterSpacing: "0.1em", background: trade.direction === "long" ? "#00d4aa22" : "#e8445a22", padding: "2px 8px", borderRadius: 4 }}>
                      {trade.direction === "long" ? "▲ LONG" : "▼ SHORT"}
                    </span>
                    <span style={{ color: "#4a5060", fontSize: 10 }}>{fmtDate(trade.date)}</span>
                    {isOpen && <span style={{ color: "#f5a623", fontSize: 9, letterSpacing: "0.1em", background: "#f5a62322", padding: "2px 8px", borderRadius: 4 }}>OPEN</span>}
                    {trade.result === "win"  && <span style={{ color: "#00d4aa", fontSize: 9 }}>✓ WIN</span>}
                    {trade.result === "loss" && <span style={{ color: "#e8445a", fontSize: 9 }}>✗ LOSS</span>}
                  </div>
                  {trade.thesis && <p style={{ color: "#8a909c", fontSize: 12, margin: 0, fontStyle: "italic" }}>"{trade.thesis}"</p>}
                </div>
                <button onClick={() => deleteTrade(i)} style={{ background: "transparent", border: "none", color: "#3a3f4a", cursor: "pointer", fontSize: 16, padding: "0 4px" }}>×</button>
              </div>

              <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: 8, marginBottom: 12 }}>
                {[
                  { l: "ENTRY",  v: `${sym(trade)}${trade.entry}` },
                  { l: "STOP",   v: `${sym(trade)}${trade.stop}` },
                  { l: "TARGET", v: `${sym(trade)}${trade.target}` },
                  { l: "R:R",    v: trade.rrRatio != null ? `${parseFloat(trade.rrRatio).toFixed(1)}R` : "—" },
                ].map((x) => (
                  <div key={x.l} style={{ background: "#0d1014", borderRadius: 6, padding: "8px 10px" }}>
                    <div style={{ color: "#4a5060", fontSize: 9, letterSpacing: "0.08em" }}>{x.l}</div>
                    <div style={{ color: "#d0d4dc", fontSize: 12, fontFamily: "'DM Mono',monospace", marginTop: 2 }}>{x.v}</div>
                  </div>
                ))}
              </div>

              {isOpen && (
                editing === i ? (
                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 8 }}>
                    <div>
                      <label style={{ ...SL, fontSize: 9 }}>EXIT PRICE</label>
                      <input style={{ ...SI, fontSize: 12, padding: "7px 10px" }} inputMode="decimal" value={trade.exitPrice} onChange={(e) => updateTrade(i, "exitPrice", e.target.value)} onFocus={hl("#f5a623")} onBlur={uhl} placeholder="0" />
                    </div>
                    <div>
                      <label style={{ ...SL, fontSize: 9 }}>RESULT</label>
                      <select value={trade.result} onChange={(e) => updateTrade(i, "result", e.target.value)} style={{ ...SI, fontSize: 12, padding: "7px 10px" }}>
                        <option value="">—</option>
                        <option value="win">Win</option>
                        <option value="loss">Loss</option>
                        <option value="breakeven">Break-even</option>
                      </select>
                    </div>
                    <div>
                      <label style={{ ...SL, fontSize: 9 }}>DISCIPLINE (1-10)</label>
                      <input style={{ ...SI, fontSize: 12, padding: "7px 10px" }} inputMode="decimal" value={trade.discipline} onChange={(e) => updateTrade(i, "discipline", e.target.value)} onFocus={hl("#a78bfa")} onBlur={uhl} placeholder="—" />
                    </div>
                    <div style={{ gridColumn: "1/-1" }}>
                      <label style={{ ...SL, fontSize: 9 }}>NOTES</label>
                      <textarea value={trade.notes || ""} onChange={(e) => updateTrade(i, "notes", e.target.value)} rows={2} placeholder="What happened? What did you learn?" style={{ ...SI, resize: "none", lineHeight: 1.5 }} onFocus={hl("#a78bfa")} onBlur={uhl} />
                    </div>
                    <button onClick={() => setEditing(null)} style={{ gridColumn: "1/-1", background: "#00d4aa22", border: "1px solid #00d4aa55", color: "#00d4aa", fontFamily: "'DM Mono',monospace", fontSize: 11, padding: "8px", borderRadius: 6, cursor: "pointer" }}>SAVE</button>
                  </div>
                ) : (
                  <button onClick={() => setEditing(i)} style={{ background: "transparent", border: "1px solid #2a2f3a", color: "#4a5060", fontFamily: "'DM Mono',monospace", fontSize: 11, padding: "7px 14px", borderRadius: 6, cursor: "pointer", letterSpacing: "0.06em" }}>CLOSE TRADE</button>
                )
              )}

              {!isOpen && (
                <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 8 }}>
                  {trade.exitPrice && <div style={{ background: "#0d1014", borderRadius: 6, padding: "8px 10px" }}><div style={{ color: "#4a5060", fontSize: 9 }}>EXIT</div><div style={{ color: "#d0d4dc", fontSize: 12, fontFamily: "'DM Mono',monospace", marginTop: 2 }}>{sym(trade)}{trade.exitPrice}</div></div>}
                  {trade.discipline && <div style={{ background: "#0d1014", borderRadius: 6, padding: "8px 10px" }}><div style={{ color: "#4a5060", fontSize: 9 }}>DISCIPLINE</div><div style={{ color: "#a78bfa", fontSize: 12, fontFamily: "'DM Mono',monospace", marginTop: 2 }}>{trade.discipline}/10</div></div>}
                  {trade.notes && <div style={{ background: "#0d1014", borderRadius: 6, padding: "8px 10px", gridColumn: "1/-1" }}><div style={{ color: "#4a5060", fontSize: 9, marginBottom: 4 }}>NOTES</div><div style={{ color: "#8a909c", fontSize: 11, lineHeight: 1.5 }}>{trade.notes}</div></div>}
                </div>
              )}
            </div>
          );
        })
      )}

      {trades.length > 0 && (
        <button onClick={() => { if (window.confirm("Clear all trades?")) { setTrades([]); saveTrades([]); } }}
          onMouseEnter={(e) => { e.currentTarget.style.borderColor = "#e8445a"; e.currentTarget.style.color = "#e8445a"; }}
          onMouseLeave={(e) => { e.currentTarget.style.borderColor = "#2a2f3a"; e.currentTarget.style.color = "#4a5060"; }}
          style={{ background: "transparent", border: "1px solid #2a2f3a", color: "#4a5060", fontFamily: "'DM Mono',monospace", fontSize: 11, padding: "8px 18px", borderRadius: 6, cursor: "pointer", letterSpacing: "0.06em", transition: "all 0.2s", marginTop: 8 }}>
          ↺ CLEAR ALL TRADES
        </button>
      )}
    </div>
  );
}

/* ═══════════════════════════════════════════════
   ROOT APP
═══════════════════════════════════════════════ */
export default function TraderApp() {
  const [user,      setUser]      = useState(null);   // Firebase user
  const [authReady, setAuthReady] = useState(false);  // waiting for auth check
  const [authError, setAuthError] = useState("");
  const [activeTab, setActiveTab] = useState("checklist");
  const [trades,    setTrades]    = useState([]);
  const [loadingData, setLoadingData] = useState(false);

  // Listen to auth state
  useEffect(() => {
    const unsub = onAuthStateChanged(auth, async (u) => {
      setUser(u);
      setAuthReady(true);
      if (u) loadUserData(u.uid);
    });
    return unsub;
  }, []);

  const loadUserData = async (uid) => {
    setLoadingData(true);
    const snap = await getDoc(userDoc(uid, "data", "trades"));
    if (snap.exists() && snap.data().list) setTrades(snap.data().list);
    setLoadingData(false);
  };

  const handleLogin = async () => {
    try {
      setAuthError("");
      await signInWithPopup(auth, provider);
    } catch (e) {
      setAuthError("Sign-in failed. Please try again.");
    }
  };

  const handleLogout = async () => {
    await signOut(auth);
    setUser(null);
    setTrades([]);
    setActiveTab("checklist");
  };

  const handleLogTrade = async (trade) => {
    const updated = [...trades, trade];
    setTrades(updated);
    await setDoc(userDoc(user.uid, "data", "trades"), { list: updated });
    setActiveTab("log");
  };

  // Loading auth state
  if (!authReady) {
    return (
      <div style={{ minHeight: "100vh", background: "#0a0c10", display: "flex", alignItems: "center", justifyContent: "center" }}>
        <style>{`@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&display=swap');`}</style>
        <p style={{ color: "#3a3f4a", fontFamily: "'DM Mono',monospace", fontSize: 12, letterSpacing: "0.1em" }}>LOADING…</p>
      </div>
    );
  }

  // Not logged in
  if (!user) return <LoginScreen onLogin={handleLogin} error={authError} />;

  // Main app
  return (
    <div style={{ minHeight: "100vh", background: "#0a0c10", fontFamily: "'DM Mono','Courier New',monospace", padding: "28px 16px 48px", display: "flex", flexDirection: "column", alignItems: "center" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Syne:wght@700;800&display=swap');
        * { box-sizing: border-box; }
        .check-item { display:flex; align-items:flex-start; gap:12px; padding:10px 12px; border-radius:6px; cursor:pointer; transition:background 0.15s; user-select:none; }
        .check-item:hover { background:rgba(255,255,255,0.04); }
        .check-item.done { opacity:0.45; }
        .checkbox { width:20px; height:20px; border-radius:4px; border:2px solid; flex-shrink:0; margin-top:1px; display:flex; align-items:center; justify-content:center; transition:background 0.2s,border-color 0.2s; font-size:12px; }
        .section-card { background:#13161c; border:1px solid #1e2229; border-radius:12px; margin-bottom:16px; overflow:hidden; transition:border-color 0.2s; }
        .section-card:hover { border-color:#2a2f3a; }
        .section-header { display:flex; align-items:center; justify-content:space-between; padding:16px 20px; cursor:pointer; gap:12px; }
        .progress-bar { height:4px; background:#1e2229; border-radius:2px; overflow:hidden; margin:0 20px 16px; }
        .chevron { transition:transform 0.2s; color:#3a3f4a; font-size:18px; }
        select { appearance:none; }
        textarea { resize:none; }
        input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
      `}</style>

      {/* Header */}
      <div style={{ maxWidth: 620, width: "100%", marginBottom: 24 }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
          <div>
            <div style={{ display: "flex", alignItems: "baseline", gap: 12, marginBottom: 4 }}>
              <h1 style={{ fontFamily: "'Syne',sans-serif", fontSize: 26, fontWeight: 800, color: "#f0f0f0", margin: 0, letterSpacing: "-0.02em" }}>TRADE CHECKLIST</h1>
              <span style={{ color: "#3a3f4a", fontSize: 12, letterSpacing: "0.1em" }}>SWING EDITION</span>
            </div>
            <p style={{ color: "#4a5060", fontSize: 11, margin: 0, letterSpacing: "0.05em" }}>HONOR THE PLAN. TRUST YOUR CALM MIND.</p>
          </div>

          {/* User + logout */}
          <div style={{ display: "flex", alignItems: "center", gap: 10, flexShrink: 0 }}>
            <img src={user.photoURL} alt="" style={{ width: 28, height: 28, borderRadius: "50%", border: "1px solid #2a2f3a" }} />
            <button onClick={handleLogout}
              onMouseEnter={(e) => { e.currentTarget.style.color = "#e8445a"; }}
              onMouseLeave={(e) => { e.currentTarget.style.color = "#4a5060"; }}
              style={{ background: "transparent", border: "none", color: "#4a5060", fontFamily: "'DM Mono',monospace", fontSize: 10, cursor: "pointer", letterSpacing: "0.06em", transition: "color 0.2s", padding: 0 }}>
              SIGN OUT
            </button>
          </div>
        </div>
      </div>

      {/* Tab bar */}
      <div style={{ maxWidth: 620, width: "100%", marginBottom: 24 }}>
        <div style={{ display: "flex", background: "#13161c", borderRadius: 10, border: "1px solid #1e2229", padding: 4, gap: 4 }}>
          {TABS.map((tab) => {
            const active = activeTab === tab.id;
            const badge  = tab.id === "log" && trades.length > 0 ? trades.length : null;
            return (
              <button key={tab.id} onClick={() => setActiveTab(tab.id)} style={{
                flex: 1, display: "flex", alignItems: "center", justifyContent: "center", gap: 6,
                background: active ? "#1e2229" : "transparent", border: "none", borderRadius: 7,
                color: active ? "#f0f0f0" : "#4a5060", fontFamily: "'DM Mono',monospace",
                fontSize: 11, letterSpacing: "0.07em", padding: "10px 4px", cursor: "pointer",
                transition: "all 0.2s", boxShadow: active ? "0 1px 4px rgba(0,0,0,0.4)" : "none", position: "relative",
              }}>
                <span style={{ fontSize: 13 }}>{tab.emoji}</span>
                <span>{tab.label}</span>
                {badge && <span style={{ background: "#00d4aa", color: "#0a0c10", fontSize: 9, fontWeight: 700, borderRadius: 8, padding: "1px 5px" }}>{badge}</span>}
                {active && <span style={{ position: "absolute", bottom: 4, left: "50%", transform: "translateX(-50%)", width: 16, height: 2, background: "#00d4aa", borderRadius: 1 }} />}
              </button>
            );
          })}
        </div>
      </div>

      {/* Content */}
      <div style={{ maxWidth: 620, width: "100%" }}>
        {loadingData ? (
          <p style={{ color: "#3a3f4a", fontSize: 11, letterSpacing: "0.1em", textAlign: "center" }}>LOADING YOUR DATA…</p>
        ) : (
          <>
            {activeTab === "checklist"  && <Checklist uid={user.uid} />}
            {activeTab === "calculator" && <RiskCalculator uid={user.uid} onLogTrade={handleLogTrade} />}
            {activeTab === "log"        && <TradeLog uid={user.uid} trades={trades} setTrades={setTrades} />}
          </>
        )}
      </div>

      <p style={{ color: "#2a2f3a", fontSize: 10, marginTop: 24, letterSpacing: "0.08em" }}>USE BEFORE EVERY TRADE SESSION</p>
    </div>
  );
}
